class CMachine : Weapon
{
	Default
	{
		Inventory.PickupMessage "one click three shots";
		Weapon.SelectionOrder 370;
		Weapon.AmmoType "CMags";
		Weapon.AmmoGive 60;
		Weapon.AmmoUse 1;
		Weapon.SlotNumber 4;
		Weapon.Kickback 100;
	}
	
	States
	{
		Spawn:
			CMAC F -1;
			Stop;
		
		Ready:
			CMAC A 1 A_WeaponReady;
			Loop;
			
		Select:
			CMAC A 1 A_Raise;
			Goto Ready;
			
		Deselect:
			CMAC A 1 A_Lower;
			Wait;
			
		Fire:
			CMAC A 1 A_GunFlash;
			CMAC A 1 A_StartSound("weapons/CMachine");
			CMAC A 1 A_FireBullets(0.1,0.1,1,8);
			CMAC B 1;
			CMAC C 1;
			CMAC B 1;
			CMAC C 1 A_FireBullets(0.1,0.1,1,8);
			CMAC C 1 A_StartSound("weapons/CMachine");
			CMAC B 1;
			CMAC C 1 A_FireBullets(0.1,0.1,1,8);
			CMAC C 1 A_StartSound("weapons/CMachine");
			CMAC B 1;
			CMAC D 1;
			CMAC E 1;
			CMAC A 1;
			Goto Ready;
	}
}

